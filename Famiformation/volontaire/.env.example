# =====================================================================
# Configuration SMTP pour l'envoi du mail d'inscription (inscription.php).
#
# 1) Copie ce fichier et renomme la copie en :  .env
# 2) Remplis les valeurs ci-dessous avec CELLES QUI MARCHENT DEJA pour
#    FamiFormation (reprends-les depuis le .env de FamiFormation).
#    L'important : SMTP_USER / SMTP_PASS = le compte admin@famiformation.com.
# =====================================================================

# Serveur SMTP IONOS (vérifie la valeur exacte dans le .env de FamiFormation)
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=465
SMTP_SECURE=ssl

# Compte d'envoi authentifié (c'est CE compte qui apparaîtra comme expéditeur)
SMTP_USER=admin@famiformation.com
SMTP_PASS=Admin+formation2026!

# Expéditeur affiché
MAIL_FROM=admin@famiformation.com
MAIL_FROM_NAME=FamiFormation

# Destinataire des inscriptions
MAIL_TO=enylson.laine@famiflora.be, Severine.santraine@famiflora.be
