{
	frankenphp
	order php_server before file_server
	# Railway termine le TLS en amont : pas de HTTPS auto dans le conteneur
	auto_https off
}

# Ecoute sur le port fourni par Railway ($PORT), 8080 par defaut en local
:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	route {
		# Bloque l'acces direct au dossier vendor/
		@vendor path /vendor/*
		respond @vendor 403

		# Bloque les fichiers sensibles (logs, dumps, backups, fichiers projet)
		@sensitive path *.log *.sql *.bak /composer.json /composer.lock /composer.phar /README.md /CHANGELOG.md /mode_emploi_admin.txt /INSTALL_PHPMailer.txt /mon_horaire_test.php /evaluation_temp.json
		respond @sensitive 403

		# Bloque les fichiers de test (test*.php / test*.xlsx)
		@testfiles path_regexp testfiles ^/test[^/]*\.(php|xlsx)$
		respond @testfiles 403

		# Bloque l'acces direct aux scores du quiz (/quiz/data/scores.json contient
		# les prenoms des participants ; seul api.php doit les lire)
		@quizdata path /quiz/data/*
		respond @quizdata 403

		# Bloque /quiz/seed/* : ces fichiers contiennent les questions du quiz AVEC
		# leurs bonnes reponses (culture.json, fun.json), plus les scripts de
		# reinstallation. Ils etaient librement telechargeables : il suffisait de
		# connaitre l'adresse pour avoir le corrige avant de jouer. api.php les lit
		# depuis le disque, pas par HTTP : les bloquer ne casse donc rien.
		@quizseed path /quiz/seed/*
		respond @quizseed 403

		# 🪪 FAMICARD : /famicard/ sert index.php tout seul (php_server reconnait
		# index.php comme index de dossier) — aucune reecriture necessaire.
		# En revanche on ferme deux portes :
		#  • includes/ ne contient que des briques appelees par les pages ;
		#    y acceder directement n'a aucun usage legitime ;
		#  • README.md decrit la structure interne et l'etat d'avancement.
		@famicardPrive path /famicard/includes/* /famicard/README.md
		respond @famicardPrive 403

		# 🎓 SOUS-DOMAINE FAMIJOB : student.famiformation.com.
		# Meme principe que « root * /app/public » plus haut, qui rend le dossier
		# public/ invisible dans l'URL du site principal : ici on rend le dossier
		# famijob/ invisible sur le sous-domaine. student.famiformation.com sert
		# donc FamiJob a sa racine, exactement comme du temps d'IONOS, et les
		# anciens favoris des etudiants continuent de fonctionner tels quels.
		#
		# REECRITURE (rewrite) et non redirection : l'URL affichee ne change pas,
		# le navigateur ne voit jamais /famijob/.
		#
		# ⚠️ Ceci ne marche QUE parce que les liens de FamiJob vers le site
		# principal passent par famijobSiteUrl() (Famijob/config.php). Sur ce
		# sous-domaine, famijob/ etant la racine, un « ../index.php » en dur
		# sortirait du site : la requete retomberait ici, serait reecrite vers
		# famijob/index.php, et bouclerait a l'infini. Ne pas reintroduire de
		# « ../ » en dur dans FamiJob.
		@famijobSousDomaine host student.famiformation.com
		rewrite @famijobSousDomaine /famijob{uri}

		# Le quiz est un site STATIQUE : son index est index.html. Or php_server ne
		# reconnait que index.php comme index de dossier : /quiz/ ne trouvait donc
		# rien et retombait sur le index.php de l'app principale, qui redirige vers
		# la connexion -> boucle de redirection. On sert explicitement index.html.
		@quizIndex path /quiz /quiz/
		rewrite @quizIndex /quiz/index.html

		# Meme chose pour la page d'administration. Le / final est impose d'abord :
		# la page appelle "../api.php", qui ne pointe au bon endroit que depuis
		# /quiz/admin/ (depuis /quiz/admin, ".." remonterait a la racine du site).
		redir /quiz/admin /quiz/admin/ 308
		@quizAdmin path /quiz/admin/
		rewrite @quizAdmin /quiz/admin/index.html

		# Page RH (/quiz/rh) : liste des recompenses a remettre. Meme principe que
		# l'admin (slash final impose pour que "../api.php" pointe sur /quiz/api.php).
		redir /quiz/rh /quiz/rh/ 308
		@quizRh path /quiz/rh/
		rewrite @quizRh /quiz/rh/index.html

		# 🏷️ LE JUSTE PRIX — VERSION D'ESSAI (/quiz/justeprix/).
		# Page a part, qui ne parle NI a l'api NI a la base : elle sert a juger le
		# jeu avant de decider s'il rejoint le quiz. Elle n'est liee depuis aucune
		# autre page, il faut connaitre l'adresse. Le / final est impose parce que
		# la page charge "articles.json" et "img/..." en relatif : sans lui, ils
		# seraient cherches dans /quiz/ et pas dans /quiz/justeprix/.
		redir /quiz/justeprix /quiz/justeprix/ 308
		@quizJustePrix path /quiz/justeprix/
		rewrite @quizJustePrix /quiz/justeprix/index.html

		# Ecrans dedies : /quiz/tele (affichage TV), /quiz/borne (borne) et
		# /quiz/code (recuperation d'un code bonus). Ils servent la MEME page que
		# /quiz ; c'est la page qui detecte le mode selon l'URL. On garde la forme
		# SANS slash final pour que le relatif "api.php" reste a la racine /quiz/.
		redir /quiz/tele/ /quiz/tele 308
		redir /quiz/borne/ /quiz/borne 308
		redir /quiz/code/ /quiz/code 308
		@quizEcrans path /quiz/tele /quiz/borne /quiz/code
		rewrite @quizEcrans /quiz/index.html

		# 🏬 DEUX MAGASINS : /quiz/mouscron et /quiz/lapanne (Mouscron / La Panne),
		# avec leurs propres ecrans /quiz/<site>/tele, /quiz/<site>/borne,
		# /quiz/<site>/code. Tout sert la MEME page ; c'est elle qui lit le magasin
		# et l'ecran dans l'URL. Le "api.php" relatif doit toujours pointer sur
		# /quiz/api.php : ces URL ont 2 ou 3 segments sous /quiz, donc le relatif
		# ne retomberait pas au bon endroit -> on l'ecrit sur /quiz/index.html en
		# gardant l'URL affichee (rewrite, pas redir).
		redir /quiz/mouscron/ /quiz/mouscron 308
		redir /quiz/lapanne/ /quiz/lapanne 308
		@quizSiteEcran path_regexp quizSiteEcran ^/quiz/(mouscron|lapanne)/(tele|borne|code)/?$
		rewrite @quizSiteEcran /quiz/index.html
		@quizSite path /quiz/mouscron /quiz/lapanne
		rewrite @quizSite /quiz/index.html

		# Mini-sites statiques /volontaire et /emails : leur index est index.html.
		# php_server ne sert que index.php comme index de dossier -> sans ca, /volontaire
		# retomberait sur l'app principale. On sert explicitement leur index.html
		# (les .php internes comme /volontaire/inscription.php restent servis normalement).
		# Slash final impose : sans lui, /volontaire (sans /) fait resoudre les chemins
		# relatifs (logo, ex/...) a la RACINE du site -> logo/pdf/video "perdus".
		redir /volontaire /volontaire/ 308
		@volontaireIndex path /volontaire/
		rewrite @volontaireIndex /volontaire/index.html
		redir /emails /emails/ 308
		@emailsIndex path /emails/
		rewrite @emailsIndex /emails/index.html

		# Sous-site La Panne : collecte des adresses e-mail du personnel.
		# Ses pages sont des index.php, php_server les sert donc tout seul —
		# aucune reecriture n'est necessaire. Le slash final, lui, est impose :
		# sans lui, les chemins relatifs (../../favicon.ico) se resolvent un cran
		# trop haut et la page perd ses ressources. Meme raison que /volontaire.
		redir /emails/lapanne /emails/lapanne/ 308
		redir /emails/lapanne/rh /emails/lapanne/rh/ 308

		# Bloque les fichiers caches (.env, .htaccess, .gitignore, ...)
		@dotfiles path_regexp dotfiles /\.[^/]+$
		respond @dotfiles 403

		php_server
	}
}
